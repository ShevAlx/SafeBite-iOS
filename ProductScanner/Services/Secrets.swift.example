import Foundation

/// Template for local secrets. Copy to `Secrets.swift` and fill in your own values.
/// `Secrets.swift` is in .gitignore — it isn't committed to git.
///
/// The Google Vision API key is no longer stored here: the app talks to a
/// Supabase Edge Function (`supabase/functions/vision-proxy`), which holds
/// the key on the server as a secret. See the README for deploying the function.
enum Secrets {
    /// Your Supabase project's URL, e.g. "https://xxxxx.supabase.co".
    static let supabaseProjectURL = "YOUR_SUPABASE_PROJECT_URL"

    /// Supabase anon (public) key — Project Settings → API.
    /// Public by design, not a secret at the level of the Vision key.
    static let supabaseAnonKey = "YOUR_SUPABASE_ANON_KEY"

    /// USDA FoodData Central API key (fdc.nal.usda.gov/api-key-signup.html).
    /// Rate-limiting only, not billing-sensitive like the Vision key — fine to
    /// ship client-side. Used as a secondary allergen check when Open Food
    /// Facts' allergens_tags comes back empty for a barcode.
    static let usdaAPIKey = "YOUR_USDA_API_KEY"
}
